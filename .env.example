# 1. AI Engine & Model Provider Keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 2. LangSmith APM & Distributed Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Praxis
LANGCHAIN_CALLBACKS_BACKGROUND=true

# 3. Supabase Database & Auth Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# 4. Data Security (AES-256-GCM)
ENCRYPTION_KEY=your_32_byte_secret_key

# 5. LinkedIn OAuth 2.0 Integration
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# 6. Optional Static Fallbacks & Logging
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LOG_LEVEL=info
LOG_FORMAT=pretty
NODE_ENV=development
